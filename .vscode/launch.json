{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Athena Server",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "core.server:app",
                "--reload"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}