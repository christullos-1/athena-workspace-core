{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Athena Server",
            "type": "shell",
            "command": "uvicorn core.server:app --reload",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}